# Application
APP_NAME=Material Passport Generator API
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# CORS (comma-separated URLs, include both local and production)
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app,https://*.onrender.com

# Model paths (relative to backend directory)
MODELS_DIR=../../models

# Server configuration
HOST=0.0.0.0
PORT=8000

# MLflow configuration (optional - set to enable production tracking)
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=../../mlruns
MLFLOW_EXPERIMENT_NAME=material-passport-production

# Production model (best performing model)
DEFAULT_MODEL=xgboost

# PDF generation
PASSPORT_TITLE=Digital Material Passport
PASSPORT_AUTHOR=Material Passport Generator

# Rate limiting (optional)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # 100 requests per 60 seconds
